---
// 03 · FF-ICE Flight Plan Converter. Accent = the decision: the Agent (the only
// judgement). The Script is deterministic — it does the conversion but makes no
// decision — so it stays grey.
---
<svg class="schematic" viewBox="0 0 300 210" role="img"
  aria-label="The agent — the decision — passes XML to a deterministic script that converts it to text">
  <text x="12" y="20">03 · FF-ICE</text>

  <rect class="s-box" x="12" y="86" width="48" height="52" rx="2" />
  <text x="36" y="115" text-anchor="middle">XML</text>

  <line class="s-line" x1="60" y1="112" x2="78" y2="112" />
  <polyline class="s-line" points="72,108 78,112 72,116" />

  <rect class="s-box s-accent" x="78" y="86" width="72" height="52" rx="2" />
  <text x="114" y="115" text-anchor="middle">Agent</text>

  <line class="s-line" x1="150" y1="112" x2="168" y2="112" />
  <polyline class="s-line" points="162,108 168,112 162,116" />

  <rect class="s-box" x="168" y="86" width="72" height="52" rx="2" />
  <text x="204" y="108" text-anchor="middle">Script</text>
  <text x="204" y="124" text-anchor="middle">Convert</text>

  <line class="s-line" x1="240" y1="112" x2="258" y2="112" />
  <polyline class="s-line" points="252,108 258,112 252,116" />

  <rect class="s-box" x="258" y="86" width="40" height="52" rx="2" />
  <text x="278" y="115" text-anchor="middle">Text</text>
</svg>
