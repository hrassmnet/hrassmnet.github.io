---
// 05 · Writing Voice Fine-Tune. A frozen base model and a small hand-built
// dataset converge into a LoRA adapter, which a held-out evaluation splits into
// two outcomes. Accent = the decision: Held-out Eval — the split verdict (tone
// transferred, facts didn't) is what the card is actually about. The base box
// is dashed because its weights never move; the adapter is the only thing
// trained, so it stays a plain box.
---
<svg class="schematic" viewBox="0 0 300 210" role="img"
  aria-label="A frozen base model and 51 hand-built examples converge into a LoRA adapter, then a held-out evaluation — the decision — splits into two outcomes: tone transferred, facts not retained">
  <text x="12" y="20">05 · Writing Voice</text>

  <!-- Inputs: weights that don't move (dashed) + the hand-built dataset -->
  <rect class="s-box" x="12" y="36" width="124" height="28" rx="2" stroke-dasharray="3 4" />
  <text x="74" y="54" text-anchor="middle">Base (frozen)</text>
  <rect class="s-box" x="164" y="36" width="124" height="28" rx="2" />
  <text x="226" y="54" text-anchor="middle">51 Examples</text>

  <!-- Both converge on the adapter -->
  <polyline class="s-line" points="74,64 74,76 150,76" />
  <polyline class="s-line" points="226,64 226,76 150,76" />
  <line class="s-line" x1="150" y1="76" x2="150" y2="86" />
  <polyline class="s-line" points="146,80 150,86 154,80" />

  <rect class="s-box" x="94" y="86" width="112" height="28" rx="2" />
  <text x="150" y="104" text-anchor="middle">LoRA Adapter</text>

  <line class="s-line" x1="150" y1="114" x2="150" y2="130" />
  <polyline class="s-line" points="146,124 150,130 154,124" />

  <rect class="s-box s-accent" x="82" y="130" width="136" height="28" rx="2" />
  <text x="150" y="148" text-anchor="middle">Held-out Eval</text>

  <!-- The split verdict -->
  <line class="s-line" x1="150" y1="158" x2="150" y2="168" />
  <line class="s-line" x1="72" y1="168" x2="228" y2="168" />
  <line class="s-line" x1="72" y1="168" x2="72" y2="178" />
  <polyline class="s-line" points="68,172 72,178 76,172" />
  <line class="s-line" x1="228" y1="168" x2="228" y2="178" />
  <polyline class="s-line" points="224,172 228,178 232,172" />

  <text x="72" y="194" text-anchor="middle">Tone transferred</text>
  <text x="228" y="194" text-anchor="middle">Facts not retained</text>
</svg>
