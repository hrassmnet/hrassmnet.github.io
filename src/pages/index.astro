---
import '../styles/global.css';

// Overview — slice 3. All seven panels laid out VERTICALLY (no horizontal
// behaviour, no motion, no schematics yet). Composition: "instrument rail" —
// every panel shares a narrow mono spine (index + vertical label) separated
// from a wide, structurally-varied content field by a single hairline.
//
// Copy is plain, factual, first person. Dates and details are taken verbatim
// from the CV — nothing invented.

// `sub` is an array so an entry can carry more than one detail line.
const journey = [
  { year: '2023',      name: 'Leaving Certificate',    sub: ['Coláiste Choilm · 601 points'] },
  { year: '2023–2027', name: 'University of Galway',    sub: ['BSc Business Information Systems'] },
  { year: '2025–2026', name: 'TBS Education, Barcelona', sub: ['Data Science for Business Study Path', 'Double-degree exchange year'] },
  { year: '?',         name: null,                      sub: null, open: true },
];

const achievements = [
  { title: 'ISO 8000 Master Data Quality Manager',      by: 'ECCMA' },
  { title: 'Model Context Protocol',                    by: 'Anthropic' },
  { title: 'AI Fluency',                                by: 'Anthropic' },
  { title: 'Claude 101',                                by: 'Anthropic' },
  { title: 'Enhance agents with autonomous capabilities', by: 'Microsoft Applied Skills' },
  { title: 'First Class Honours',                       by: 'Y1 71% · Y2 75%' },
  { title: 'Academic Scholarship',                      by: 'Y1 & Y2' },
];

// Triptych — word + image only (Design.md §06). Identical treatment across
// all three: same 1:1 frame, same hairline border, same mono label. Images
// are 1000×1000 monochrome, served from public/images.
const interests = [
  { label: 'History',     src: '/images/history.jpg',
    alt: 'The Augustus of Prima Porta — a Roman marble statue of the emperor Augustus, one arm raised.' },
  { label: 'Cybernetics', src: '/images/cybernetics.jpg',
    alt: 'A mid-twentieth-century analogue computer control room, banks of dials and switches.' },
  { label: 'Philosophy',  src: '/images/philosophy.jpg',
    alt: "The Creation of Adam — the detail of God's and Adam's hands almost touching." },
];

const contact = [
  { k: 'Email',  v: 'jack.don.bates@gmail.com', href: 'mailto:jack.don.bates@gmail.com' },
  { k: 'GitHub', v: 'github.com/hrassmnet',      href: 'https://github.com/hrassmnet', ext: true },
  { k: 'CV',     v: 'cv.pdf',                    href: '/cv.pdf', download: true },
];

// The ITSD email pipeline. Rendered here as a plain mono readout; the live
// self-pulsing SVG that replaces it is slice 05.
const pipeline = ['Inbox', 'Pre-filter', 'Classify', 'KB Search', 'Action'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Jack Bates</title>
    <meta
      name="description"
      content="Jack Bates — Business Information Systems, University of Galway. AI agents and data work at EUROCONTROL."
    />
  </head>
  <body>
    <main class="mx-auto max-w-[1120px] px-6 md:px-12">

      <!-- 01 · HERO ------------------------------------------------------ -->
      <section class="grid min-h-screen grid-cols-[64px_1fr] md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">01</span>
          <span class="label [writing-mode:vertical-rl]">Identity</span>
        </div>
        <div class="flex flex-col justify-center py-24 pl-6 md:py-32 md:pl-12">
          <h1 class="text-display-xl">Jack Bates</h1>
          <p class="text-h3 text-text-muted mt-6 max-w-measure">
            Business Information Systems — University of Galway
          </p>

          <div class="mt-16">
            <p class="label mb-4">ITSD Pipeline</p>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-3 rounded-[2px] border border-rule px-6 py-5">
              {pipeline.map((n, i) => (
                <>
                  <span class="font-mono text-small uppercase tracking-wide text-text">{n}</span>
                  {i < pipeline.length - 1 && (
                    <span class="font-mono text-small text-text-muted" aria-hidden="true">→</span>
                  )}
                </>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 02 · JOURNEY --------------------------------------------------- -->
      <section class="grid grid-cols-[64px_1fr] border-t border-rule md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">02</span>
          <span class="label [writing-mode:vertical-rl]">Journey</span>
        </div>
        <div class="py-24 pl-6 md:py-32 md:pl-12">
          <h2 class="text-display-l">The route so far</h2>

          <ol class="mt-16 grid gap-y-12 md:grid-cols-4 md:gap-x-6">
            {journey.map((s) => (
              <li class="relative border-t border-rule pt-6">
                <span class={`absolute -top-[3px] left-0 block h-[5px] w-[5px] rounded-full ${s.open ? 'bg-accent' : 'bg-text'}`} aria-hidden="true"></span>
                {s.open ? (
                  <span class="font-mono text-display-l leading-none text-accent" aria-label="the future is open">?</span>
                ) : (
                  <>
                    <div class="font-mono text-small text-text-muted tabular-nums">{s.year}</div>
                    <div class="text-h3 mt-3">{s.name}</div>
                    <div class="mt-1 space-y-0.5">
                      {s.sub.map((l) => <div class="text-small text-text-muted">{l}</div>)}
                    </div>
                  </>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 03 · EXPERIENCE ------------------------------------------------ -->
      <section class="grid grid-cols-[64px_1fr] border-t border-rule md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">03</span>
          <span class="label [writing-mode:vertical-rl]">Experience</span>
        </div>
        <div class="py-24 pl-6 md:py-32 md:pl-12">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <span class="label">EUROCONTROL · Brussels</span>
            <span class="font-mono text-small text-text-muted">Apr–Aug 2026</span>
          </div>
          <h2 class="text-display-l mt-8">Power Platform &amp; AI Solutions Engineer</h2>
          <p class="text-h2 text-text mt-10 max-w-measure">
            On the Skyline traineeship I designed and shipped a suite of AI agents for
            EUROCONTROL's Network Management Directorate, built on custom MCP connectors and tools.
          </p>
        </div>
      </section>

      <!-- 04 · PROJECTS DOOR --------------------------------------------- -->
      <section class="grid min-h-screen grid-cols-[64px_1fr] border-t border-rule md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">04</span>
          <span class="label [writing-mode:vertical-rl]">Projects</span>
        </div>
        <div class="flex flex-col justify-center py-24 pl-6 md:py-32 md:pl-12">
          <span class="label">The substance</span>
          <a
            href="/projects"
            class="group mt-6 inline-flex items-baseline gap-6 text-display-xl text-text transition-colors hover:text-accent"
          >
            Projects
            <span class="text-display-l text-accent transition-transform group-hover:translate-x-2" aria-hidden="true">→</span>
          </a>
          <p class="font-mono text-small text-text-muted mt-8">
            06 cards · EUROCONTROL / PERSONAL / ACADEMIC
          </p>
        </div>
      </section>

      <!-- 05 · ACHIEVEMENTS ---------------------------------------------- -->
      <section class="grid grid-cols-[64px_1fr] border-t border-rule md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">05</span>
          <span class="label [writing-mode:vertical-rl]">Achievements</span>
        </div>
        <div class="py-24 pl-6 md:py-32 md:pl-12">
          <h2 class="text-display-l">Supporting evidence</h2>
          <dl class="mt-16 max-w-measure border-b border-rule">
            {achievements.map((a) => (
              <div class="flex items-baseline justify-between gap-6 border-t border-rule py-4">
                <dt class="font-mono text-small text-text">{a.title}</dt>
                <dd class="font-mono text-small text-text-muted text-right">{a.by}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- 06 · INTERESTS ------------------------------------------------- -->
      <section class="grid grid-cols-[64px_1fr] border-t border-rule md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">06</span>
          <span class="label [writing-mode:vertical-rl]">Interests</span>
        </div>
        <div class="py-24 pl-6 md:py-32 md:pl-12">
          <h2 class="text-display-l">Interests</h2>
          <!-- 3-up at/above 900px (the site's stack breakpoint), stacked below. -->
          <div class="mt-16 grid gap-6 min-[900px]:grid-cols-3">
            {interests.map((it) => (
              <figure>
                <div class="aspect-square overflow-hidden rounded-[2px] border border-rule bg-surface">
                  <img
                    src={it.src}
                    alt={it.alt}
                    width="1000"
                    height="1000"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </div>
                <figcaption class="label mt-4">{it.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- 07 · CONTACT / FOOTER ------------------------------------------ -->
      <section class="grid grid-cols-[64px_1fr] border-t border-rule md:grid-cols-[128px_1fr]">
        <div class="flex flex-col items-center gap-6 border-r border-rule pt-24 md:pt-32">
          <span class="font-mono text-h2 leading-none text-text-muted tabular-nums">07</span>
          <span class="label [writing-mode:vertical-rl]">Contact</span>
        </div>
        <div class="py-24 pl-6 md:py-32 md:pl-12">
          <h2 class="text-display-l">Get in touch</h2>

          <dl class="mt-16 max-w-measure border-b border-rule">
            {contact.map((c) => (
              <div class="flex items-baseline justify-between gap-6 border-t border-rule py-5">
                <dt class="label">{c.k}</dt>
                <dd>
                  <a
                    href={c.href}
                    class="font-mono text-small text-accent hover:underline"
                    {...(c.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    {...(c.download ? { download: true } : {})}
                  >
                    {c.v}
                  </a>
                </dd>
              </div>
            ))}
          </dl>

          <p class="text-h2 mt-24 max-w-measure text-text">
            Change is inevitable. Progress isn't. What separates them is what we manage to build.
          </p>
        </div>
      </section>

    </main>
  </body>
</html>
